# URL interna do PostgreSQL criado no Render
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BASE
# Gere uma chave longa e aleatória; mantenha-a estável entre deploys
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA
# Origem do frontend; '*' pode ser mantido quando tudo é servido pelo mesmo domínio
CORS_ORIGINS=*
COOKIE_SECURE=true
# Credenciais para criar/promover a conta administradora inicial
ADMIN_EMAIL=seu-email-administrador@dominio.com
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_COM_12_OU_MAIS_CARACTERES
ADMIN_NAME=Administrador GeoAgreste

# OAuth Google (opcional até configurar o provedor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://SEU-DOMINIO.onrender.com/auth/google/callback
